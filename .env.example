# Copy this file to .env (which is gitignored) and fill in the values:
#   cp .env.example .env

# Your Foursquare app's credentials, from https://foursquare.com/developers/.
# They're only used to get an access token: with these set and no FSQ_TOKEN,
# the script opens your browser to log in and prints a token.
FSQ_CLIENT_ID=
FSQ_CLIENT_SECRET=

# Paste the access token printed by the first run here. Once it's set, the
# client ID and secret are no longer needed.
FSQ_TOKEN=
